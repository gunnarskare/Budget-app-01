# Kopier til .env.local og fyll ut. ALDRI commit .env.local.

# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<prosjekt-ref>.supabase.co
# «Publishable key» (eller den eldre «anon key»). Trygg å eksponere – RLS beskytter dataene.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- OpenAI (valgfritt) ---
# Uten nøkkel fungerer appen fullt ut; kun AI-steget i kategoriseringen hoppes over.
# Nøkkelen brukes kun på serveren og sendes aldri til nettleseren.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Valgfritt ---
# Brukes i e-postlenker (bekreftelse / glemt passord). Standard: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
